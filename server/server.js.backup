
const express = require('express');
const { MongoClient, ObjectId } = require('mongodb');
const cors = require('cors');
const bcrypt = require('bcryptjs');
const jwt = require('jsonwebtoken');

const app = express();
const PORT = 5000;

// For local development only. Set a strong secret in an environment variable
// before deploying this app anywhere public.
const JWT_SECRET =
    process.env.JWT_SECRET || 'dear-wardrobe-local-dev-secret-change-before-deployment';

app.use(cors());
app.use(express.json({ limit: '7mb' }));

const client = new MongoClient('mongodb://127.0.0.1:27017');

async function startServer() {
    try {
        await client.connect();

        const db = client.db('dear_wardrobe');
        const clothes = db.collection('clothes');
        const users = db.collection('users');
        const outfits = db.collection('outfits');

        await users.createIndex({ email: 1 }, { unique: true });

        console.log('Connected to local MongoDB!');

        app.get('/', (req, res) => {
            res.send('Dear Wardrobe API is running!');
        });

        // Create a new user account.
        app.post('/api/auth/register', async (req, res) => {
            try {
                const { name, email, password } = req.body;

                if (
                    typeof name !== 'string' ||
                    !name.trim() ||
                    typeof email !== 'string' ||
                    !email.trim() ||
                    typeof password !== 'string' ||
                    password.length < 8
                ) {
                    return res.status(400).json({
                        message: 'Enter your name, a valid email, and a password of at least 8 characters.'
                    });
                }

                const normalizedEmail = email.trim().toLowerCase();

                const existingUser = await users.findOne({
                    email: normalizedEmail
                });

                if (existingUser) {
                    return res.status(409).json({
                        message: 'An account with this email already exists.'
                    });
                }

                const passwordHash = await bcrypt.hash(password, 12);

                const result = await users.insertOne({
                    name: name.trim(),
                    email: normalizedEmail,
                    passwordHash,
                    createdAt: new Date()
                });

                const token = jwt.sign(
                    { userId: result.insertedId.toString() },
                    JWT_SECRET,
                    { expiresIn: '7d' }
                );

                res.status(201).json({
                    token,
                    user: {
                        id: result.insertedId.toString(),
                        name: name.trim(),
                        email: normalizedEmail
                    }
                });
            } catch (error) {
                if (error.code === 11000) {
                    return res.status(409).json({
                        message: 'An account with this email already exists.'
                    });
                }

                console.error('Registration error:', error.message);
                res.status(500).json({ message: 'Could not create account.' });
            }
        });

        // Log in an existing user.
        app.post('/api/auth/login', async (req, res) => {
            try {
                const { email, password } = req.body;

                if (
                    typeof email !== 'string' ||
                    typeof password !== 'string'
                ) {
                    return res.status(400).json({
                        message: 'Enter your email and password.'
                    });
                }

                const user = await users.findOne({
                    email: email.trim().toLowerCase()
                });

                if (
                    !user ||
                    !(await bcrypt.compare(password, user.passwordHash))
                ) {
                    return res.status(401).json({
                        message: 'Incorrect email or password.'
                    });
                }

                const token = jwt.sign(
                    { userId: user._id.toString() },
                    JWT_SECRET,
                    { expiresIn: '7d' }
                );

                res.json({
                    token,
                    user: {
                        id: user._id.toString(),
                        name: user.name,
                        email: user.email
                    }
                });
            } catch (error) {
                console.error('Login error:', error.message);
                res.status(500).json({ message: 'Could not log in.' });
            }
        });

        // Verify the token and identify the current user.
        function authenticate(req, res, next) {
            const authHeader = req.headers.authorization || '';
            const token = authHeader.startsWith('Bearer ')
                ? authHeader.slice(7)
                : '';

            if (!token) {
                return res.status(401).json({
                    message: 'Please log in to continue.'
                });
            }

            try {
                const payload = jwt.verify(token, JWT_SECRET);

                if (!ObjectId.isValid(payload.userId)) {
                    return res.status(401).json({
                        message: 'Invalid login token.'
                    });
                }

                req.userId = new ObjectId(payload.userId);
                next();
            } catch {
                return res.status(401).json({
                    message: 'Your session expired. Please log in again.'
                });
            }
        }

        app.get('/api/auth/me', authenticate, async (req, res) => {
            const user = await users.findOne(
                { _id: req.userId },
                { projection: { passwordHash: 0 } }
            );

            if (!user) {
                return res.status(404).json({
                    message: 'Account not found.'
                });
            }

            res.json({
                user: {
                    id: user._id.toString(),
                    name: user.name,
                    email: user.email
                }
            });
        });

        // Each user can see only their own clothing items.
        app.get('/api/clothes', authenticate, async (req, res) => {
            try {
                const items = await clothes
                    .find({ userId: req.userId })
                    .sort({ createdAt: -1 })
                    .toArray();

                res.json(items);
            } catch (error) {
                console.error('Load clothes error:', error.message);
                res.status(500).json({ message: 'Could not load clothes.' });
            }
        });

        app.post('/api/clothes', authenticate, async (req, res) => {
            try {
                const { name, category, color, image, emoji, type } = req.body;

                if (
                    typeof name !== 'string' ||
                    !name.trim() ||
                    typeof category !== 'string' ||
                    !category.trim()
                ) {
                    return res.status(400).json({
                        message: 'Name and category are required.'
                    });
                }

                const item = {
                    userId: req.userId,
                    name: name.trim(),
                    category: category.trim(),
                    color: typeof color === 'string' ? color : '',
                    image: typeof image === 'string' ? image : '',
                    emoji: typeof emoji === 'string' ? emoji : '👚',
                    type: typeof type === 'string' ? type : 'custom',
                    createdAt: new Date()
                };

                const result = await clothes.insertOne(item);

                res.status(201).json({
                    ...item,
                    _id: result.insertedId
                });
            } catch (error) {
                console.error('Save clothes error:', error.message);
                res.status(500).json({ message: 'Could not save clothing item.' });
            }
        });

        app.delete('/api/clothes/:id', authenticate, async (req, res) => {
            try {
                if (!ObjectId.isValid(req.params.id)) {
                    return res.status(400).json({
                        message: 'Invalid item ID.'
                    });
                }

                const result = await clothes.deleteOne({
                    _id: new ObjectId(req.params.id),
                    userId: req.userId
                });

                res.json({ deleted: result.deletedCount === 1 });
            } catch (error) {
                console.error('Delete clothes error:', error.message);
                res.status(500).json({ message: 'Could not delete clothing item.' });
            }
        });

        // Save and retrieve outfit canvases for each user.
        app.get('/api/outfits', authenticate, async (req, res) => {
            try {
                const savedOutfits = await outfits
                    .find({ userId: req.userId })
                    .sort({ createdAt: -1 })
                    .toArray();

                res.json(savedOutfits);
            } catch (error) {
                res.status(500).json({ message: 'Could not load outfits.' });
            }
        });

        app.post('/api/outfits', authenticate, async (req, res) => {
            try {
                const { name, items } = req.body;

                if (
                    typeof name !== 'string' ||
                    !name.trim() ||
                    !Array.isArray(items)
                ) {
                    return res.status(400).json({
                        message: 'An outfit name and items are required.'
                    });
                }

                const outfit = {
                    userId: req.userId,
                    name: name.trim(),
                    items: items.slice(0, 50),
                    createdAt: new Date()
                };

                const result = await outfits.insertOne(outfit);

                res.status(201).json({
                    ...outfit,
                    _id: result.insertedId
                });
            } catch (error) {
                res.status(500).json({ message: 'Could not save outfit.' });
            }
        });

        app.listen(PORT, () => {
            console.log(`Dear Wardrobe API running at http://localhost:${PORT}`);
        });
    } catch (error) {
        console.error('Startup failed:', error.message);
    }
}

startServer();
